{
    "name": "utp/scholarship-system",
    "description": "UTP Scholarship and Course Eligibility Engine",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "sentry/sentry": "^4.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "UTP\\": "src/"
        }
    },
    "authors": [
        {
            "name": "UTP Engineering",
            "email": "engineering@utp.edu.my"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    }
}
