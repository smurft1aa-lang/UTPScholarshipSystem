{
    "name": "utp/scholarship-system",
    "description": "UTP Scholarship and Course Eligibility Engine",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "bjeavons/zxcvbn-php": "^1.4",
        "phpmailer/phpmailer": "^7.0",
        "sentry/sentry": "^4.0.0",
        "spomky-labs/otphp": "^11.4"
    },
    "require-dev": {
        "phpstan/phpstan": "2.0",
        "phpunit/phpunit": "^11.0",
        "robmorgan/phinx": "^0.16.11",
        "squizlabs/php_codesniffer": "3.10",
        "vimeo/psalm": "^6.5",
        "zircote/swagger-php": "^6.1"
    },
    "autoload": {
        "psr-4": {
            "UTP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --colors=always --coverage-html coverage",
        "lint": "phpcs --standard=phpcs.xml",
        "lint:fix": "phpcbf --standard=phpcs.xml",
        "analyse": "phpstan analyse --no-progress",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "UTP Engineering",
            "email": "engineering@utp.edu.my"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    }
}
