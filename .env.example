# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=utp_scholarship
DB_USER=root
DB_PASS=your_secure_password_here

# Application
APP_ENV=local
APP_URL=http://localhost:8080

# Admin Setup (REQUIRED before first run)
ADMIN_EMAIL=admin@utp.edu.my
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOYING

# Mail (SMTP via PHPMailer)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@utp.edu.my

# Security
TRUSTED_PROXY=
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=1

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5        # Max failed login attempts before lockout
RATE_LIMIT_WINDOW_MINUTES=1      # Time window in minutes for rate limiting

# Telemetry
SENTRY_DSN=

# File Uploads
UPLOAD_DIR=uploads/documents

# OCR.space API (for AI result scanning)
OCR_API_KEY=your_ocr_space_api_key
